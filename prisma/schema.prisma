// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  ATASAN
  PEGAWAI
}

enum StatusDialog {
  draft_atasan
  menunggu_pegawai
  menunggu_atasan
  menunggu_validasi
  selesai
}

enum JenisAspek {
  SKP
  GAP_ASESMEN
  PERILAKU
  KARIR_PENDEK
  KARIR_MENENGAH
}

enum Triwulan {
  TW1
  TW2
  TW3
  TW4
}

enum StatusReviu {
  draft_pegawai
  menunggu_atasan
  menunggu_validasi
  selesai
}

model User {
  id                       Int      @id @default(autoincrement())
  npp                      String   @unique @db.VarChar(50)
  nip                      String?  @unique @db.VarChar(50)
  nama_pegawai             String   @db.VarChar(255)
  tanggal_bergabung        DateTime? @db.Date
  nama_jabatan             String?  @db.VarChar(150)
  unit_kerja               String?  @db.VarChar(150)
  masa_kerja_unit_terakhir String?  @db.VarChar(100)
  password                 String   @db.VarChar(255)

  default_role             Role     @default(PEGAWAI) // peran default saat login (bukan pembatas akses)
  as_pegawai               Boolean  @default(false)   // true kalau user ini bawahan seseorang
  is_admin                 Boolean  @default(false)   // kapabilitas admin, independen dari atasan/pegawai
  is_active                Boolean  @default(true)    // soft delete

  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  id_atasan Int?
  atasan    User?  @relation("Hierarki", fields: [id_atasan], references: [id])
  bawahan   User[] @relation("Hierarki")

  dialogAsAtasan  DialogKinerja[] @relation("DialogAtasan")
  dialogAsPegawai DialogKinerja[] @relation("DialogPegawai")

  notifications Notification[]
  importedItems ImportStagingItem[] @relation("ImportedBy")

  @@map("users")
}

model MasterMetodePengembangan {
  id          Int    @id @default(autoincrement())
  nama_metode String @db.VarChar(255)
  is_active   Boolean @default(true)

  dialogItems DialogKinerjaItem[]

  @@map("master_metode_pengembangan")
}

model DialogKinerja {
  id                     Int          @id @default(autoincrement())
  id_atasan              Int
  id_pegawai             Int
  periode_tahun          Int
  triwulan               Triwulan
  deskripsi_kinerja      String?      @db.Text
  status                 StatusDialog @default(draft_atasan)
  is_valid_pegawai       Boolean      @default(false)
  is_valid_atasan        Boolean      @default(false)
  ttd_pegawai_path       String?      @db.VarChar(255)
  ttd_atasan_path        String?      @db.VarChar(255)
  waktu_validasi_pegawai DateTime?
  waktu_validasi_atasan  DateTime?
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt

  atasan  User @relation("DialogAtasan", fields: [id_atasan], references: [id], onDelete: Restrict)
  pegawai User @relation("DialogPegawai", fields: [id_pegawai], references: [id], onDelete: Restrict)

  id_dialog_induk Int?

  aspek DialogKinerjaAspek[]
  reviu Reviu[]

  dialog_induk    DialogKinerja? @relation("DialogLanjutan", fields: [id_dialog_induk], references: [id], onDelete: SetNull)
  dialog_lanjutan DialogKinerja[] @relation("DialogLanjutan")

  @@map("dialog_kinerja")
}

model DialogKinerjaAspek {
  id                     Int        @id @default(autoincrement())
  id_dialog              Int
  jenis_aspek            JenisAspek
  tanggung_jawab_pegawai String?    @db.Text
  tanggung_jawab_atasan  String?    @db.Text
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt

  dialog DialogKinerja @relation(fields: [id_dialog], references: [id], onDelete: Cascade)
  item   DialogKinerjaItem[]

  @@unique([id_dialog, jenis_aspek])

  @@map("dialog_kinerja_aspek")
}

model DialogKinerjaItem {
  id                          Int       @id @default(autoincrement())
  id_aspek                    Int
  dialog_evaluasi             String?   @db.Text
  kompetensi_dikembangkan     String?   @db.Text
  id_metode_pengembangan      Int?
  metode_pengembangan_lainnya String?   @db.VarChar(255)
  waktu_pelaksanaan           DateTime?   @default(now())
  is_tercapai                 Boolean?   // null = belum direviu
  capaian_keterangan          String?    @db.Text
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  aspek  DialogKinerjaAspek          @relation(fields: [id_aspek], references: [id], onDelete: Cascade)
  metode MasterMetodePengembangan?  @relation(fields: [id_metode_pengembangan], references: [id], onDelete: SetNull)

  @@map("dialog_kinerja_item")
}

model Reviu {
  id                     Int                @id @default(autoincrement())
  id_dialog              Int
  is_tercapai            Boolean            @default(false)
  is_tidak_tercapai      Boolean            @default(false)
  penjelasan_tercapai    String?            @db.Text
  penjelasan_tidak_tercapai String?          @db.Text
  rencana_tindak_lanjut  String?            @db.Text
  tanggal_next_evaluasi  DateTime?          @db.Date @map("tanggal_next_reviu")
  status                 StatusReviu        @default(draft_pegawai)
  is_valid_pegawai       Boolean            @default(false)
  is_valid_atasan        Boolean            @default(false)
  ttd_pegawai_path       String?            @db.VarChar(255)
  ttd_atasan_path        String?            @db.VarChar(255)
  waktu_validasi_pegawai DateTime?
  waktu_validasi_atasan  DateTime?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  dialog DialogKinerja @relation(fields: [id_dialog], references: [id], onDelete: Cascade)

  @@map("reviu")
}

model Notification {
  id          Int      @id @default(autoincrement())
  id_user     Int
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  description String   @db.Text
  link        String   @db.VarChar(500)
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())

  user User @relation(fields: [id_user], references: [id], onDelete: Cascade)

  @@index([id_user, is_read])
  @@index([id_user, created_at])
  @@map("notifications")
}

model ImportStagingItem {
  id            Int        @id @default(autoincrement())
  jenis_aspek   JenisAspek              // SKP | GAP_ASESMEN | PERILAKU
  periode_tahun Int
  triwulan      Triwulan               // TW1 | TW3
  npp           String     @db.VarChar(50)
  narasi        String     @db.Text    // teks yang masuk ke dialog_evaluasi
  metadata      Json?                   // data mentah (target, capaian, nilai, dll.)
  is_consumed   Boolean    @default(false)
  id_dialog     Int?
  batch_id      String     @db.VarChar(100)
  imported_by   Int
  imported_at   DateTime   @default(now())

  importer User @relation("ImportedBy", fields: [imported_by], references: [id])

  @@index([npp, jenis_aspek, periode_tahun, triwulan])
  @@index([batch_id])
  @@map("import_staging_items")
}
